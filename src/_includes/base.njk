{% from "assembly-components.njk" import smile %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{{ title | default("$DRB — DebtReliefBot · DRB Task Force") }}</title>
  <meta name="description" content="{{ description | default('Follow the story, the wallet, and the conversations around DebtReliefBot ($DRB).') }}">
  <link rel="icon" type="image/png" href="/assets/images/assembly/drb.png">
  <link rel="apple-touch-icon" href="/assets/images/assembly/drb.png">
  <link rel="canonical" href="https://drbtaskforce.com{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://drbtaskforce.com{{ page.url }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="https://drbtaskforce.com/assets/images/og-image.png">
  <meta property="og:image:alt" content="DebtReliefBot ($DRB)">
  <meta name="twitter:site" content="@DRBTaskForce">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="https://drbtaskforce.com/assets/images/og-image.png">
  {% if noindex %}<meta name="robots" content="noindex">{% endif %}
  <link rel="stylesheet" href="/assets/css/assembly.css">
  {% if pageStyle %}<link rel="stylesheet" href="/assets/css/{{ pageStyle }}.css">{% endif %}
  {% if secondary %}<link rel="stylesheet" href="/assets/css/secondary.css">{% endif %}
  <link rel="stylesheet" href="/assets/css/identity.css">
  {% if secondary %}
  <style>.motion-pending body.secondary main{visibility:hidden}</style>
  <script>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && Element.prototype.animate) {
      document.documentElement.classList.add('motion-pending');
      window.__drbMotionDeadline = setTimeout(() => {
        window.__drbMotionExpired = true;
        document.documentElement.classList.remove('motion-pending');
      }, 1500);
    }
  </script>
  {% endif %}
  <script src="/assets/js/assembly.js" defer></script>
  {% if secondary %}<script src="/assets/js/secondary.js" defer></script>{% endif %}
</head>
<body class="assembly{% if secondary %} secondary{% endif %}">
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="header-inner wrap">
      <a class="brand brand-taskforce" href="/" aria-label="DRB Task Force home"><img src="/assets/images/taskforce-logo.png" width="38" height="38" alt=""><span>DRB Task Force</span></a>
      <nav class="site-menu" id="site-menu" aria-label="Main navigation">
        <a href="{% if secondary %}/origin/{% else %}/#origin{% endif %}" {% if page.url == '/origin/' %}aria-current="page"{% endif %}>The origin</a>
        <a href="/token/" {% if page.url == '/token/' %}aria-current="page"{% endif %}>The token</a>
        <a href="/community/" {% if page.url == '/community/' %}aria-current="page"{% endif %}>The Community</a>
        <a href="/wallet/" {% if page.url == '/wallet/' %}aria-current="page"{% endif %}>Wallet</a>
        <a href="/movement/" {% if page.url == '/movement/' %}aria-current="page"{% endif %}>Movement</a>
        <a class="menu-telegram" href="https://t.me/+J2c-wexHmCJmOThl" target="_blank" rel="noopener noreferrer">Telegram</a>
      </nav>
      <div class="header-actions"><a class="brand brand-token" href="/token/" aria-label="DebtReliefBot, $DRB token">{{ smile('header-smile') }}<span>$DRB</span></a><a class="button" href="https://t.me/+J2c-wexHmCJmOThl" target="_blank" rel="noopener noreferrer">Telegram</a><button class="menu-toggle" type="button" aria-controls="site-menu" aria-expanded="false">Menu</button></div>
    </div>
  </header>
  <main id="main" tabindex="-1">{{ content | safe }}</main>
  <footer class="site-footer">
    <div class="footer-inner wrap">
      <div>
        <p>DRB Task Force · An independent community around DebtReliefBot ($DRB). Not affiliated with xAI or Grok.</p>
        <p>$DRB is a meme token. This site provides informational content only and is not financial advice. Cryptocurrency trading involves significant risk of loss. No debt relief or investment returns are promised.</p>
      </div>
      <div class="footer-links"><a id="official-x-profile" href="https://x.com/DRBTaskForce" target="_blank" rel="noopener noreferrer">DRB Task Force on X</a><button class="motion-toggle" type="button" aria-pressed="false">Pause motion</button></div>
    </div>
  </footer>
  <button class="chat-launch" id="drb-chat-btn" type="button" aria-label="Open DebtReliefBot chat" aria-haspopup="dialog" aria-controls="drb-chat-window">{{ smile('chat-launch-smile', 36) }}</button>
  <dialog class="chat-window" id="drb-chat-window" aria-labelledby="chat-title" aria-describedby="chat-description">
    <div class="chat-heading">
      <div class="chat-identity">{{ smile('chat-heading-smile', 30) }}<div><h2 id="chat-title">DebtReliefBot</h2><p id="chat-description">Powered by Grok</p></div></div>
      <button class="chat-close" type="button" aria-label="Close chat">×</button>
    </div>
    <div id="drb-messages" class="chat-messages" role="log" aria-live="polite" aria-relevant="additions text" aria-label="Conversation"><p class="chat-intro">Ask about $DRB, its story, or the wallet.</p></div>
    <form class="chat-form" id="drb-chat-form" novalidate>
      <label class="visually-hidden" for="drb-user-input">Your message</label>
      <input id="drb-user-input" name="message" type="text" placeholder="Ask about $DRB…" autocomplete="off" required>
      <button id="drb-send-btn" class="button primary" type="submit" aria-label="Send message">Send</button>
    </form>
  </dialog>
  {% if pageScript %}<script src="/assets/js/{{ pageScript }}.js" defer></script>{% endif %}
  {% if xPosts %}<script src="/assets/js/x-posts.js" defer></script>{% endif %}
  <script src="https://cdn.jsdelivr.net/npm/marked@11.1.1/marked.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/dompurify@3.4.15/dist/purify.min.js" defer></script>
  <script src="/assets/js/chat.js" defer></script>
</body>
</html>
