{% macro smile(id, size=40, label="") %}
<svg class="drb-face drb-cutout" viewBox="0 0 278 278" width="{{ size }}" height="{{ size }}" {% if label %}role="img" aria-label="{{ label }}"{% else %}aria-hidden="true"{% endif %} focusable="false"><defs><mask id="{{ id }}" maskUnits="userSpaceOnUse" x="0" y="0" width="278" height="278" style="mask-type:luminance"><image href="data:image/png;base64," width="278" height="278"/></mask></defs><rect width="278" height="278" fill="currentColor" mask="url(#{{ id }})"/></svg>
{% endmacro %}
{% macro contractBlock(id="contract-address") %}
<div class="contract-block"><div class="contract-row"><div><small>$DRB CONTRACT / BASE</small><code id="{{ id }}">0x3ec2156d4c0a9cbdab4a016633b7bcf6a8d68ea2</code></div><div class="contract-actions"><button class="button" type="button" data-copy>Copy address</button><a class="text-link" href="https://basescan.org/token/0x3ec2156d4c0a9cbdab4a016633b7bcf6a8d68ea2" target="_blank" rel="noopener noreferrer">Basescan</a></div></div><p class="copy-status" role="status" aria-live="polite"></p></div>
{% endmacro %}
