{% set savedCreators = attention | default({}) %}
{% macro portrait(leader) %}
<span class="leader-portrait" aria-hidden="true"><span>{{ leader.author | truncate(2, true, '') | upper | escape }}</span>{% if leader.avatar %}<img src="{{ leader.avatar | escape }}" width="96" height="96" alt="" loading="lazy">{% endif %}</span>
{% endmacro %}
{% macro profile(leader) %}{% if leader.author | lower == 'drbtaskforce' %}#official-x-profile{% else %}https://x.com/{{ leader.author | escape }}{% endif %}{% endmacro %}
<section class="section movement-attention" id="attention" aria-labelledby="attention-title">
  <header class="movement-attention-heading">
    <div>
      <h1 id="attention-title">Getting $DRB seen.</h1>
      <p class="movement-ranking-intro">Top 15 Accounts bringing attention to $DRB.</p>
    </div>
    <div class="segmented movement-period-controls" role="group" aria-label="Ranking period" hidden>
      <button type="button" data-period="daily" aria-pressed="true" aria-controls="lb-period-daily">24 hours</button>
      <button type="button" data-period="weekly" aria-pressed="false" aria-controls="lb-period-weekly">7 days</button>
      <button type="button" data-period="monthly" aria-pressed="false" aria-controls="lb-period-monthly">30 days</button>
    </div>
  </header>

  <p class="movement-snapshot">Rankings saved {% if savedCreators.asOf %}<time datetime="{{ savedCreators.asOf }}" data-snapshot>{{ savedCreators.asOf | formatDate }}</time>{% else %}<span>date unavailable</span>{% endif %}. Updated daily.</p>
  {% if creators.metricRechecks.unavailablePosts > 0 %}<p class="movement-note">Some posts use earlier saved counts because their follow-up metrics check was unavailable.</p>{% endif %}

    <div class="movement-ranking-panel" id="lb-periods">
      {% for period, label in [['daily', '24 hours'], ['weekly', '7 days'], ['monthly', '30 days']] %}
        {% set leaders = savedCreators[period] | default([]) %}
        <section class="movement-period-panel" id="lb-period-{{ period }}" data-ranking-period="{{ period }}" aria-labelledby="lb-title-{{ period }}">
          <div class="movement-ranking-heading">
            <h3 id="lb-title-{{ period }}">{{ label }}</h3>
          </div>
          {% if leaders.length %}
            <div class="movement-ranking-scroll" tabindex="0" role="region" aria-label="{{ label }} top 15 accounts">
              <table class="movement-ranking-table">
                <caption class="movement-sr-only">{{ label }} top 15 accounts by impressions, from highest to lowest</caption>
                <thead class="movement-sr-only"><tr><th scope="col">Rank / account</th><th scope="col">Impressions and share</th></tr></thead>
                <tbody>
                  {% for leader in leaders %}{% if loop.index <= 15 %}
                    <tr{% if loop.first %} class="movement-leading-row"{% endif %} data-leader data-author="{{ leader.author | escape }}" data-avatar="{{ leader.avatar | default('') | escape }}" data-impressions="{{ leader.impressions }}" data-share="{{ leader.pct }}" data-rank="{{ loop.index }}">
                      <th scope="row">
                        <span class="movement-rank">{{ loop.index }}</span>
                        <a class="leader-row-profile" href="{{ profile(leader) }}" {% if leader.author | lower != 'drbtaskforce' %}target="_blank" rel="noopener noreferrer"{% endif %}>{{ portrait(leader) }}<span>@{{ leader.author | escape }}</span></a>
                      </th>
                      <td><span data-number>{{ leader.impressions }}</span><span class="movement-ranking-metric">impressions <span>· {{ leader.pct }}% share</span></span></td>
                    </tr>
                  {% endif %}{% endfor %}
                </tbody>
              </table>
            </div>
          {% else %}
            <div class="movement-ranking-empty">
              <h4>No saved ranking for this period.</h4>
              <p>Choose another period or read the posts below.</p>
            </div>
          {% endif %}
        </section>
      {% endfor %}
      <div class="movement-paging" hidden>
        <p id="lb-range" role="status" aria-live="polite" aria-atomic="true"></p>
        <div class="movement-paging-buttons">
          <button type="button" class="button" id="lb-previous" aria-label="Previous ranking page">Previous</button>
          <button type="button" class="button" id="lb-next" aria-label="Next ranking page">Next</button>
        </div>
      </div>
    </div>
</section>
