<script>
/* First-scroll assembly. Original content is the visible no-JS fallback. */
(() => {
  const preference = matchMedia('(prefers-reduced-motion: reduce)');
  if (preference.matches || !Element.prototype.animate) return;
  const tracks = [];
  const opening = new Set();
  const cleanups = [];
  const root = document.documentElement;
  const clamp = value => Math.max(0, Math.min(1, value));
  const ease = 'cubic-bezier(.25,.65,.3,1)';
  let frame = 0, lastTime = 0, stopped = false, control;

  const revealAll = () => {
    stopped = true;
    cancelAnimationFrame(frame);
    tracks.forEach(track => track.animation.cancel());
    opening.forEach(animation => animation.cancel());
    opening.clear();
    cleanups.forEach(fn => fn());
    root.classList.remove('motion-enabled');
    if (control) { control.textContent = 'Motion off'; control.setAttribute('aria-pressed', 'true'); control.setAttribute('aria-label', 'Motion off; all content is visible'); }
  };

  try {
    root.classList.add('motion-enabled');
    const make = (target, frames, id, options = {}) => {
      const animation = target.animate(frames, { duration: 1000, fill: 'both', easing: ease, ...options });
      animation.pause();
      animation.currentTime = 0;
      animation.id = id;
      return animation;
    };
    const words = target => {
      const inks = [];
      // Keep actual text and spaces in the accessibility tree, without duplicate labels.
      for (const node of [...target.childNodes]) {
        if (node.nodeType !== Node.TEXT_NODE) continue;
        const fragment = document.createDocumentFragment();
        node.textContent.split(/(\s+)/).forEach(part => {
          if (!part || /^\s+$/.test(part)) { fragment.append(part); return; }
          const word = document.createElement('span');
          const ink = document.createElement('span');
          word.className = 'motion-word'; ink.className = 'motion-ink';
          ink.textContent = part; word.append(ink); fragment.append(word); inks.push(ink);
        });
        node.replaceWith(fragment);
      }
      return inks;
    };
    const baseline = [
      { transform: 'translateY(108%)' },
      { transform: 'translateY(0)' }
    ];
    const surface = [
      { clipPath: 'inset(0 100% 0 0)' },
      { clipPath: 'inset(0 0% 0 0)' }
    ];
    const lift = [
      { clipPath: 'inset(100% 0 0 0)', transform: 'translateY(18px)' },
      { clipPath: 'inset(0% 0 0 0)', transform: 'translateY(0)' }
    ];
    const play = (target, frames, id, delay, duration) => {
      const animation = make(target, frames, id, { delay, duration });
      opening.add(animation);
      animation.onfinish = () => { animation.cancel(); opening.delete(animation); };
      return animation;
    };
    const scroll = (target, anchor, frames, id, { offset = 0, span = 180, enter = .9, depth = 0, easing = ease } = {}) => {
      const animation = make(target, frames, id, { easing });
      const track = { animation, anchor, offset, span, enter, depth, start: 0, end: 0, value: 0, goal: 0, done: false };
      tracks.push(track);
      return track;
    };
    const text = (target, id, { offset = 0, span = 155, spread = 90, enter = .9 } = {}) => {
      const parts = words(target);
      parts.forEach((ink, index) => scroll(ink, target, baseline, `${id}-${index}`, {
        offset: offset + spread * index / Math.max(1, parts.length - 1), span, enter
      }));
    };
    const block = (selector, id, options) => {
      const target = document.querySelector(selector);
      scroll(target, target, lift, id, options);
    };
    const svgElement = name => document.createElementNS('http://www.w3.org/2000/svg', name);

    // The face stays intact and fixed in its original layout. A broad feathered
    // mask travels down the image over 2.4 seconds, overlapping the typography.
    const face = document.querySelector('.hero-face');
    face.style.maskImage = 'linear-gradient(to bottom, #000 42%, transparent 58%)';
    face.style.maskSize = '100% 240%';
    face.style.maskRepeat = 'no-repeat';
    play(face, [{ maskPosition: '0% 100%' }, { maskPosition: '0% 0%' }], 'hero-face', 160, 2400)
      .effect.updateTiming({ easing: 'ease-in-out' });
    words(document.querySelector('.hero-word')).forEach(ink => play(ink, baseline, 'hero-wordmark', 0, 1450));
    let headlineIndex = 0;
    document.querySelectorAll('.hero-title > span').forEach(line => words(line).forEach(ink => {
      play(ink, baseline, `hero-headline-${headlineIndex}`, 500 + headlineIndex++ * 80, 1150);
    }));
    const description = words(document.querySelector('.hero-description'));
    description.forEach((ink, index) => play(ink, baseline, `hero-description-${index}`, 1150 + index * 17, 850));
    document.querySelectorAll('.actions > a').forEach((link, index) => {
      // A parent carries the entrance so the link's own transform remains available for hover.
      const sleeve = document.createElement('span'); sleeve.className = 'motion-action';
      link.before(sleeve); sleeve.append(link);
      play(sleeve, lift, `hero-action-${index}`, 1650 + index * 110, 850);
    });
    document.querySelectorAll('.provenance > *').forEach((target, index) => {
      const animation = play(target, surface, `hero-source-${index}`, 1850 + index * 100, 850);
      // Sources below the initial mobile viewport assemble when reached.
      if (target.getBoundingClientRect().top > innerHeight * .94) {
        opening.delete(animation); animation.cancel();
        scroll(target, target, surface, `source-${index}`, { span: 160, offset: index * 10 });
      }
    });

    text(document.querySelector('#holders-title'), 'holders-title', { span: 190 });
    text(document.querySelector('.holders-subtitle'), 'holders-phrase', { span: 140, spread: 110 });
    text(document.querySelector('.holders-aside p'), 'holders-aside', { offset: 45 });
    block('.holders-aside .text-link', 'holders-link', { offset: 65, span: 150 });

    const scene = document.querySelector('#layered-scene');
    const definitions = scene.querySelector('defs');
    // Spatial reveal of the complete original connected artwork, without
    // separating figures or pretending the flattened raster is independent 3D.
    const sceneClip = svgElement('mask');
    sceneClip.id = 'assembly-rooftop-mask';
    sceneClip.setAttribute('maskUnits', 'userSpaceOnUse');
    sceneClip.style.maskType = 'luminance';
    Object.entries({ x: 0, y: 0, width: 1536, height: 1024 }).forEach(([key, value]) => sceneClip.setAttribute(key, value));
    const feather = svgElement('linearGradient'); feather.id = 'assembly-rooftop-feather';
    feather.innerHTML = '<stop offset="0" stop-color="white"/><stop offset=".88" stop-color="white"/><stop offset="1" stop-color="black"/>';
    definitions.append(feather);
    const sceneWindow = svgElement('rect');
    Object.entries({ x: 0, y: 0, width: 1746, height: 1024, fill: 'url(#assembly-rooftop-feather)' }).forEach(([key, value]) => sceneWindow.setAttribute(key, value));
    sceneClip.append(sceneWindow); definitions.append(sceneClip);
    const artwork = document.querySelector('#layer-artwork');
    const revealLayer = svgElement('g'); revealLayer.setAttribute('mask', 'url(#assembly-rooftop-mask)');
    artwork.before(revealLayer); revealLayer.append(artwork);
    scroll(sceneWindow, scene, [{ width: '0px' }, { width: '1746px' }], 'holders-rooftop', { span: 370, offset: 75, depth: .34, enter: .88, easing: 'linear' });
    const inkFilter = svgElement('filter'); inkFilter.id = 'assembly-star-ink';
    inkFilter.setAttribute('color-interpolation-filters', 'sRGB');
    inkFilter.innerHTML = '<feColorMatrix type="matrix" values="-.2126 -.7152 -.0722 0 1 -.2126 -.7152 -.0722 0 1 -.2126 -.7152 -.0722 0 1 0 0 0 1 0"/>';
    const inkMask = svgElement('mask'); inkMask.id = 'assembly-star-mask';
    inkMask.setAttribute('maskUnits', 'userSpaceOnUse'); inkMask.style.maskType = 'luminance';
    Object.entries({ x: 0, y: 0, width: 1536, height: 1024 }).forEach(([key, value]) => inkMask.setAttribute(key, value));
    const inkSource = svgElement('use'); inkSource.setAttribute('href', '#original-rooftop');
    inkSource.setAttribute('filter', 'url(#assembly-star-ink)'); inkMask.append(inkSource);
    definitions.append(inkFilter, inkMask);
    [...scene.querySelectorAll('[data-art-layer="star"]')].forEach((star, index) => {
      const box = scene.querySelector(`#star-clip-${index + 1} rect`);
      const centerX = Number(box.getAttribute('x')) + Number(box.getAttribute('width')) / 2;
      const centerY = Number(box.getAttribute('y')) + Number(box.getAttribute('height')) / 2;
      // Reveal each original star as its own position enters the visible sky.
      // Gentle growth lasts for the full scroll interval; the old oversized
      // circular clip exposed the tiny ink shape almost immediately.
      scroll(star, scene, [
        { opacity: 0, transform: 'scale(.35)' },
        { opacity: 1, transform: 'scale(.65)', offset: .4 },
        { opacity: 1, transform: 'scale(1)' }
      ], `holders-star-${index + 1}`, {
        offset: index * 14, depth: centerY / 1024, span: 220, enter: .78, easing: 'ease-in-out'
      });
      const accent = box.cloneNode(false); accent.setAttribute('fill', '#c6983e');
      accent.setAttribute('mask', 'url(#assembly-star-mask)'); accent.setAttribute('opacity', '0');
      star.append(accent);
      // The growing stars begin in warm gold and share a long color hold as
      // the rooftop completes, then settle gradually back to the original ink.
      scroll(accent, scene, [{ opacity: 1 }, { opacity: 1, offset: .6 }, { opacity: 0 }], `holders-gold-${index + 1}`, {
        offset: 130 + index * 12, depth: .34, span: 450, enter: .78, easing: 'linear'
      });
    });

    document.querySelectorAll('#movement .section-intro, #wallet .section-intro').forEach(intro => {
      const name = intro.closest('section').id;
      text(intro.querySelector('.section-kicker'), `${name}-kicker`, { span: 135, spread: 35 });
      text(intro.querySelector('.section-title'), `${name}-title`, { span: 190 });
      text(intro.querySelector('.section-deck'), `${name}-deck`, { span: 160, spread: 80 });
      text(intro.querySelector('.section-body'), `${name}-body`, { span: 150, spread: 100 });
      intro.querySelectorAll('a').forEach((link, index) => {
        const sleeve = document.createElement('div'); sleeve.className = 'motion-link-sleeve';
        link.before(sleeve); sleeve.append(link);
        scroll(sleeve, sleeve, lift, `${name}-link-${index}`, { span: 140 });
      });
    });
    block('.ranking-header', 'movement-table-heading', { offset: 75, span: 160 });
    block('.ranking thead', 'movement-columns', { offset: 40, span: 160 });
    document.querySelectorAll('.ranking tbody tr').forEach((row, index) => {
      [...row.cells].forEach((cell, cellIndex) => scroll(cell, row, lift, `movement-row-${index}-${cellIndex}`, { span: 175, offset: cellIndex * 20 }));
      const bar = row.querySelector('.metric-bar');
      scroll(bar, row, [{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], `movement-bar-${index}`, { span: 190, offset: 85, easing: 'linear' });
    });
    text(document.querySelector('.ranking-note'), 'movement-note', { span: 140, spread: 60 });

    const panel = document.querySelector('.wallet-panel');
    scroll(panel, panel, [{ clipPath: 'inset(0 0 100% 0 round 5px)' }, { clipPath: 'inset(0 0 0% 0 round 5px)' }], 'wallet-panel', { span: 320, enter: .93 });
    block('.wallet-panel-head', 'wallet-panel-heading', { offset: 25, span: 140 });
    text(document.querySelector('.wallet-total'), 'wallet-value', { span: 180, offset: 30 });
    text(document.querySelector('.wallet-date'), 'wallet-date', { span: 140, offset: 30, spread: 30 });
    const chart = document.querySelector('.chart');
    const chartSvg = chart.querySelector('svg');
    const chartDefs = svgElement('defs');
    const clip = svgElement('clipPath'); clip.id = 'wallet-series-reveal';
    clip.setAttribute('clipPathUnits', 'userSpaceOnUse');
    const windowRect = svgElement('rect');
    Object.entries({ x: 44, y: 0, width: 476, height: 190 }).forEach(([key, value]) => windowRect.setAttribute(key, value));
    clip.append(windowRect); chartDefs.append(clip); chartSvg.append(chartDefs);
    const series = svgElement('g'); series.setAttribute('clip-path', 'url(#wallet-series-reveal)');
    const area = chart.querySelector('.chart-area'); chartSvg.insertBefore(series, area);
    series.append(area, chart.querySelector('.chart-line'), chart.querySelector('.chart-end'));
    scroll(windowRect, chart, [{ width: '0px' }, { width: '476px' }], 'wallet-chart', { span: 290, enter: .92, easing: 'linear' });
    text(document.querySelector('.chart-caption'), 'wallet-caption', { span: 110, spread: 40 });
    document.querySelectorAll('.balance-list > div').forEach((item, index) => {
      scroll(item, item, lift, `wallet-balance-${index}`, { span: 160, offset: index % 2 * 25 });
    });
    block('.wallet-foot', 'wallet-fees', { span: 150 });

    text(document.querySelector('#token-title'), 'token-title', { span: 180 });
    text(document.querySelector('.token-intro'), 'token-intro', { span: 150, spread: 65 });
    document.querySelectorAll('.token-facts > div').forEach((fact, index) => {
      scroll(fact, fact, lift, `token-fact-${index}`, { span: 180, offset: index * 40 });
    });
    block('.contract', 'token-contract', { span: 190 });
    text(document.querySelector('.contract-label'), 'token-contract-label', { span: 150, spread: 60 });
    document.querySelectorAll('.token-links a').forEach((link, index) => {
      const sleeve = document.createElement('span'); sleeve.className = 'motion-action';
      link.before(sleeve); sleeve.append(link);
      scroll(sleeve, sleeve, lift, `token-link-${index}`, { span: 150, offset: index * 25 });
    });

    const measure = () => {
      const maxScroll = Math.max(1, root.scrollHeight - innerHeight);
      for (const track of tracks) {
        const bounds = track.anchor.getBoundingClientRect();
        const top = bounds.top + scrollY + bounds.height * track.depth;
        const scale = Math.min(1, innerWidth / 900) * .45 + .55;
        const desiredStart = top - innerHeight * track.enter + track.offset * scale;
        // The last facts and links must finish within the real page, without padding it out.
        track.end = Math.min(maxScroll - 16, desiredStart + track.span * scale);
        track.start = Math.min(desiredStart, track.end - Math.min(130, track.span * scale));
      }
    };
    const targetProgress = () => {
      for (const track of tracks) {
        if (!track.done) track.goal = Math.max(track.goal, clamp((scrollY - track.start) / (track.end - track.start)));
      }
    };
    const tick = now => {
      frame = 0;
      const delta = Math.min(50, now - (lastTime || now - 16.7)); lastTime = now;
      const follow = 1 - Math.exp(-delta / 65);
      let moving = false;
      for (const track of tracks) {
        if (track.done) continue;
        track.value += (track.goal - track.value) * follow;
        if (Math.abs(track.goal - track.value) < .0004) track.value = track.goal;
        track.animation.currentTime = track.value * 1000;
        if (track.value >= 1) { track.animation.cancel(); track.done = true; }
        else if (track.value !== track.goal) moving = true;
      }
      if (moving && !stopped) frame = requestAnimationFrame(tick);
    };
    const update = () => {
      if (stopped) return;
      targetProgress();
      if (!frame) { lastTime = 0; frame = requestAnimationFrame(tick); }
    };
    const remeasure = () => { if (!stopped) { measure(); update(); } };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', remeasure, { passive: true });
    cleanups.push(() => { removeEventListener('scroll', update); removeEventListener('resize', remeasure); });

    // Keyboard navigation reveals the destination immediately, including controls
    // inside still-assembling surfaces. Pointer clicks on section anchors do too.
    const showSection = section => {
      if (!section) return;
      tracks.forEach(track => {
        if (section.contains(track.anchor)) { track.animation.cancel(); track.done = true; }
      });
      opening.forEach(animation => {
        if (section.contains(animation.effect.target)) { animation.cancel(); opening.delete(animation); }
      });
    };
    document.addEventListener('focusin', event => showSection(event.target.closest('section')));
    document.addEventListener('click', event => {
      const link = event.target.closest('a[href^="#"]');
      if (link) showSection(document.getElementById(link.getAttribute('href').slice(1)));
    });
    const hash = () => showSection(document.getElementById(location.hash.slice(1)));
    addEventListener('hashchange', hash);

    control = document.createElement('button');
    control.className = 'motion-control'; control.type = 'button';
    control.textContent = 'Pause motion'; control.setAttribute('aria-pressed', 'false');
    control.setAttribute('aria-label', 'Pause motion and show all content');
    control.addEventListener('click', revealAll);
    document.querySelector('.footer-main').append(control);
    preference.addEventListener('change', event => { if (event.matches) revealAll(); });
    addEventListener('pagehide', revealAll, { once: true });
    measure(); targetProgress();
    tracks.forEach(track => { track.value = track.goal; track.animation.currentTime = track.value * 1000; });
    hash();
    // Wait for original embedded images before starting the single opening clock.
    Promise.all([...document.images].map(img => img.decode().catch(() => {}))).then(() => {
      if (!stopped) opening.forEach(animation => animation.play());
      remeasure();
    });
  } catch (error) {
    revealAll();
    console.warn('Motion is unavailable; the complete design remains visible.', error);
  }
})();
</script>
</body>
</html>
