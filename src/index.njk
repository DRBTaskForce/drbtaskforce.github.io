---
layout: false
permalink: /index.html
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="description" content="Explore DebtReliefBot ($DRB), its public origin, community, token records, and wallet on Base.">
  <link rel="canonical" href="https://drbtaskforce.com/">
  <link rel="icon" type="image/png" href="/assets/images/assembly/drb.png">
  <title>$DRB — DebtReliefBot · DRB Task Force</title>
  <style>
    :root {
      --paper:#fcfcfc; --ink:#1b1d1f; --muted:#5e646a; --line:#d1d5d8;
      --wash:#f0f2f3; --white:#fff; --sans:"Helvetica Neue",Helvetica,Arial,sans-serif;
      --mono:"SFMono-Regular",Consolas,"Liberation Mono",monospace;
      --gutter:clamp(24px,5.55vw,80px); --thumb:#969ca1; --thumb-hover:#6a7177;
    }
    *{box-sizing:border-box;scrollbar-color:var(--thumb) var(--wash);scrollbar-width:thin}
    *::-webkit-scrollbar{width:10px;height:10px}
    *::-webkit-scrollbar-track{background:var(--wash)}
    *::-webkit-scrollbar-thumb{background:var(--thumb);border:2px solid var(--wash);border-radius:6px}
    *::-webkit-scrollbar-thumb:hover{background:var(--thumb-hover)}
    *::-webkit-scrollbar-thumb:active{background:var(--ink)}
    html{scroll-behavior:auto;background:var(--paper);color:var(--ink)}
    body{margin:0;font-family:var(--sans);font-weight:400;-webkit-font-smoothing:antialiased}
    a{color:inherit;cursor:pointer;text-underline-offset:5px;text-decoration-thickness:1px}
    a:hover{text-decoration-thickness:2px}
    a:active{opacity:.7}
    a:focus-visible{outline:2px solid var(--ink);outline-offset:5px;border-radius:2px}
    img{display:block;max-width:100%;height:auto}
    h1,h2,h3,p,figure,dl,dd{margin:0}
    .wrap{width:min(100% - var(--gutter)*2,1280px);margin-inline:auto}
    .skip-link{position:absolute;z-index:10;top:12px;left:16px;background:var(--ink);color:var(--white);padding:14px;transform:translateY(-160%)}
    .skip-link:focus{transform:none}
    .site-header{border-bottom:1px solid var(--line)}
    .header-inner{min-height:100px;display:flex;align-items:center;justify-content:space-between;gap:28px}
    .brand{display:flex;align-items:center;gap:15px;text-decoration:none;flex-shrink:0}
    .badge{width:52px;height:52px;border-radius:50%;object-fit:cover}
    .brand-name{font-size:15px;font-weight:500;letter-spacing:.02em}
    .nav{display:flex;align-items:center;gap:32px;font-size:15px;font-weight:400}
    .nav a{min-height:44px;display:inline-flex;align-items:center;text-decoration:none}
    .nav a:hover{text-decoration:underline}
    .header-telegram{margin-left:14px!important;text-decoration:underline!important}
    .hero{position:relative;padding-top:65px;padding-bottom:76px}
    .hero-word{font-size:210px;line-height:.9;letter-spacing:-.075em;font-weight:700;margin-left:-9px}
    .hero-face{position:absolute;width:440px;height:440px;right:9px;top:75px;filter:invert(1);mix-blend-mode:multiply}
    .hero-title{font-size:48px;line-height:1.08;letter-spacing:-.05em;font-weight:500;margin-top:30px;max-width:760px}
    .hero-title span{display:block}
    .hero-description{font-size:20px;line-height:1.5;color:var(--muted);max-width:510px;margin-top:23px}
    .actions{display:flex;align-items:center;gap:28px;flex-wrap:wrap;margin-top:32px}
    .button{min-height:50px;padding:15px 25px;display:inline-flex;align-items:center;justify-content:center;background:var(--ink);border:1px solid var(--ink);border-radius:3px;color:var(--white);font-size:15px;line-height:20px;text-decoration:none}
    .button:hover{background:#363b3f;text-decoration:none}
    .text-link{display:inline-flex;align-items:center;gap:12px;min-height:44px;font-size:15px}
    .provenance{border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:grid;grid-template-columns:1.1fr 1fr 1fr 1fr;gap:24px;padding:27px 0 28px;align-items:center}
    .utility{font-family:var(--mono);font-size:11px;line-height:1.55;letter-spacing:.07em;text-transform:uppercase;color:var(--muted)}
    .provenance-intro strong{display:block;font-size:14px;font-weight:500;margin-bottom:4px}
    .source-link{display:flex;align-items:center;gap:13px;min-height:48px;font-size:14px;text-decoration:none}
    .source-link span:last-child{text-decoration:underline;text-underline-offset:5px}
    .source-link:hover span:last-child{text-decoration-thickness:2px}
    .source-mark{display:flex;align-items:center;justify-content:center;width:34px;height:34px;border:1px solid var(--line);border-radius:50%;font-size:12px;flex-shrink:0}
    .source-mark svg{width:14px;height:14px}
    .holders{padding-top:83px;padding-bottom:18px}
    .holders-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:30px}
    .section-title{font-size:72px;line-height:1;letter-spacing:-.06em;font-weight:500}
    .holders .section-title{font-size:90px}
    .holders-subtitle{font-size:16px;line-height:1.5;font-weight:400;color:var(--muted);margin-top:17px}
    .holders-aside{padding-top:13px;min-width:220px}
    .holders-aside p{font-size:14px;color:var(--muted);margin-bottom:6px}
    .rooftop{display:block;width:100%;height:auto;aspect-ratio:3/2;mix-blend-mode:multiply;margin-top:-20px}
    .rooftop .scene-layer{transform-box:view-box;transform-origin:center}
    .movement{padding:95px 0 94px;background:var(--wash)}
    .split{display:grid;grid-template-columns:.88fr 1.12fr;gap:85px;align-items:start}
    .section-kicker{margin-bottom:23px}
    .section-deck{font-size:24px;line-height:1.3;letter-spacing:-.025em;margin-top:26px;max-width:390px}
    .section-body{font-size:16px;line-height:1.6;color:var(--muted);max-width:335px;margin-top:17px}
    .section-intro .text-link,.section-intro .button{margin-top:25px}
    .ranking{padding-top:2px}
    .ranking-header{display:flex;justify-content:space-between;align-items:center;gap:20px;padding-bottom:20px;border-bottom:1px solid #bfc5c9}
    .ranking-header h3{font-size:16px;font-weight:500;letter-spacing:-.02em}
    .ranking table{border-collapse:collapse;width:100%;font-size:15px}
    .ranking th{font-size:11px;font-family:var(--mono);font-weight:400;color:var(--muted);padding:16px 0 4px;text-align:left;text-transform:uppercase;letter-spacing:.06em}
    .ranking th:last-child{text-align:right}
    .ranking td{padding:19px 0;border-bottom:1px solid var(--line)}
    .ranking .rank{width:38px;color:var(--muted);font-family:var(--mono);font-size:12px}
    .ranking .account a{text-decoration:none;display:inline-flex;align-items:center;min-height:28px;font-weight:500}
    .ranking .account a:hover{text-decoration:underline}
    .ranking .metric{text-align:right;position:relative;width:150px;font-variant-numeric:tabular-nums;padding-left:16px}
    .metric-value{display:block;margin-bottom:6px;font-size:18px;letter-spacing:-.03em}
    .metric-bar{display:block;height:2px;background:var(--ink);margin-left:auto;width:var(--bar);max-width:100%}
    .ranking-note{font-size:12px;line-height:1.55;color:var(--muted);margin-top:17px;max-width:480px}
    .wallet{padding:105px 0 99px}
    .wallet .split{grid-template-columns:.88fr 1.12fr}
    .wallet .section-body{max-width:320px}
    .wallet-address{display:inline-block;font-family:var(--mono);font-size:11px;color:var(--muted);margin-top:24px;line-height:1.6;max-width:100%;overflow-wrap:anywhere}
    .wallet-panel{border:1px solid var(--line);border-radius:5px;background:var(--white);padding:30px 31px 26px}
    .wallet-panel-head{display:flex;justify-content:space-between;gap:15px;align-items:flex-start}
    .wallet-panel-head h3{font-size:13px;font-weight:400;color:var(--muted)}
    .snapshot-tag{font-family:var(--mono);font-size:10px;text-transform:uppercase;letter-spacing:.04em;padding:5px 7px;border:1px solid var(--line);border-radius:3px;color:var(--muted);white-space:nowrap}
    .wallet-total{font-size:51px;line-height:1.15;letter-spacing:-.045em;font-weight:400;margin-top:12px;font-variant-numeric:tabular-nums}
    .wallet-date{font-size:11px;line-height:1.6;color:var(--muted);margin-top:6px}
    .chart{margin-top:25px}
    .chart svg{width:100%;height:auto;display:block;overflow:visible}
    .chart-label{font:11px var(--mono);fill:var(--muted)}
    .chart-grid{stroke:var(--line);stroke-width:1}
    .chart-line{stroke:var(--ink);stroke-width:2;fill:none;stroke-linejoin:round;stroke-linecap:round}
    .chart-caption{font-size:11px;line-height:1.55;color:var(--muted);margin-top:5px}
    .balance-list{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line);margin-top:23px;gap:20px 28px;padding-top:23px}
    .balance-list dt{font-family:var(--mono);font-size:10px;letter-spacing:.04em;color:var(--muted);margin-bottom:6px}
    .balance-list dd{font-size:18px;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
    .wallet-foot{border-top:1px solid var(--line);padding-top:16px;margin-top:23px;display:flex;justify-content:space-between;gap:15px;font-size:11px;line-height:1.5;color:var(--muted)}
    .wallet-foot strong{font-weight:500;color:var(--ink);white-space:nowrap;font-variant-numeric:tabular-nums}
    .token{padding:80px 0 68px;border-top:1px solid var(--line)}
    .token-heading{display:flex;justify-content:space-between;align-items:end;gap:24px}
    .token-intro{font-size:16px;color:var(--muted);padding-bottom:4px}
    .token-facts{display:grid;grid-template-columns:.85fr .85fr 1.3fr;gap:40px;margin-top:45px;margin-bottom:38px}
    .token-facts>div+div{border-left:1px solid var(--line);padding-left:40px}
    .token-facts dt{font-size:12px;color:var(--muted);margin-bottom:12px}
    .token-facts dd{font-size:38px;line-height:1;letter-spacing:-.045em}
    .contract{display:flex;align-items:center;justify-content:space-between;gap:28px;background:var(--wash);padding:22px 25px;border-radius:3px}
    .contract-label{font-size:11px;color:var(--muted);margin-bottom:8px}
    .contract code{font-family:var(--mono);font-size:15px;line-height:1.6;overflow-wrap:anywhere}
    .contract a{font-size:13px;white-space:nowrap;min-height:44px;display:inline-flex;align-items:center}
    .token-links{display:flex;gap:32px;margin-top:14px;flex-wrap:wrap}
    .site-footer{border-top:1px solid var(--line);padding:33px 0 30px}
    .footer-main{display:flex;align-items:center;justify-content:space-between;gap:24px}
    .footer-main .badge{width:43px;height:43px}
    .footer-main .brand-name{font-size:13px}
    .footer-link{font-size:13px;min-height:44px;display:inline-flex;align-items:center}
    .footer-note{font-size:11px;color:var(--muted);line-height:1.6;margin-top:22px;display:flex;justify-content:space-between;gap:24px}
    /* Motion wrappers preserve real text, source geometry and native layout. */
    .motion-word,.hero-title .motion-word{display:inline-block;overflow:clip;vertical-align:bottom;padding:0 .09em .09em;margin:0 -.09em -.09em}
    .motion-ink,.hero-title .motion-ink{display:inline-block}
    .motion-action{display:inline-flex}
    .motion-link-sleeve{display:flow-root}
    .metric-bar{transform-origin:left center}
    .motion-control{font:11px var(--mono);color:var(--muted);border:1px solid var(--line);border-radius:3px;background:transparent;min-height:36px;padding:8px 12px;cursor:pointer;margin-left:auto}
    .motion-control:focus-visible{outline:2px solid var(--ink);outline-offset:4px}
    .nav a{position:relative}
    .nav a::after{content:"";position:absolute;left:0;right:0;bottom:7px;height:1px;background:currentColor;transform:scaleX(0);transform-origin:left;transition:transform 240ms cubic-bezier(.2,.7,.2,1)}
    .nav a:hover{text-decoration:none}
    .nav a:hover::after,.nav a:focus-visible::after{transform:scaleX(1)}
    .brand,.button,.text-link,.source-link,.wallet-address,.contract a,.footer-link,.mobile-telegram,.ranking .account a,.motion-control{transition:transform 260ms cubic-bezier(.2,.7,.2,1),box-shadow 260ms,border-color 260ms,background-color 260ms;text-decoration-thickness:1px}
    .button:focus-visible{transform:translateY(-3px);box-shadow:0 6px 12px #1b1d1f1a}
    .brand:focus-visible,.text-link:focus-visible,.source-link:focus-visible,.wallet-address:focus-visible,.contract a:focus-visible,.footer-link:focus-visible,.ranking .account a:focus-visible{transform:translateY(-2px)}
    .ranking tbody tr{transition:background-color 240ms}
    @media(hover:hover) and (pointer:fine){
      .button:hover{transform:translateY(-3px);box-shadow:0 6px 12px #1b1d1f1a;border-color:#454b50}
      .brand:hover,.text-link:hover,.source-link:hover,.wallet-address:hover,.contract a:hover,.footer-link:hover,.mobile-telegram:hover,.ranking .account a:hover{transform:translateY(-2px)}
      .source-link:hover .source-mark{border-color:var(--ink)}
      .ranking tbody tr:hover{background:#e7ebed}
      .motion-control:hover{background:var(--wash);border-color:var(--muted)}
    }
    @media(max-width:520px){.motion-control{margin-left:0}.actions>.motion-action{flex-shrink:0}}
    @media(min-width:1500px){.hero-face{right:35px}}
    @media(max-width:1100px){
      .nav{gap:20px}.brand-name{font-size:13px}.header-telegram{margin-left:0!important}
      .hero-word{font-size:174px}.hero-title{font-size:40px;max-width:620px}.hero-face{width:330px;height:330px;right:0;top:64px}.hero-description{max-width:465px;font-size:18px}
      .split,.wallet .split{gap:40px;grid-template-columns:.9fr 1.1fr}.section-title{font-size:58px}.wallet-total{font-size:43px}
      .wallet-panel{padding:26px 24px}.provenance{gap:14px}.source-link{font-size:12px;gap:9px}.source-mark{width:28px;height:28px}
    }
    @media(max-width:800px){
      .header-inner{display:grid;grid-template-columns:1fr auto;gap:0;min-height:118px;padding-top:17px}.brand{gap:10px}.badge{width:42px;height:42px}
      .brand-name{font-size:12px}.nav{grid-column:1/-1;grid-row:2;justify-content:space-between;gap:8px;font-size:13px;width:100%;padding-top:8px;padding-bottom:7px}
      .header-telegram{display:none!important}.header-inner>.mobile-telegram{display:inline-flex;font-size:12px;min-height:44px;align-items:center}
      .hero{padding-top:46px;padding-bottom:52px}.hero-lockup{display:flex;align-items:center;justify-content:space-between;gap:4px}.hero-word{font-size:clamp(113px,21vw,145px)}.hero-face{position:static;width:30%;height:auto;aspect-ratio:1;flex-shrink:0}.hero-title{font-size:39px;max-width:570px;margin-top:32px}.hero-description{max-width:455px;font-size:18px}
      .provenance{grid-template-columns:1fr 1fr;padding:23px 0;gap:18px 20px}.provenance-intro{align-self:center}
      .holders{padding-top:59px;padding-bottom:18px}.holders .section-title{font-size:70px}.holders-aside{min-width:0;padding-top:5px}.rooftop{margin-top:10px}
      .split,.wallet .split{grid-template-columns:1fr;gap:43px}.section-title{font-size:64px}.section-kicker{margin-bottom:18px}
      .section-deck{font-size:24px;max-width:none;margin-top:22px}.section-body{max-width:450px}.section-intro .text-link,.section-intro .button{margin-top:19px}
      .movement{padding:64px 0}.ranking-header{padding-bottom:18px}.ranking td{padding:15px 0}.ranking .metric{width:135px}
      .wallet{padding:65px 0}.wallet .section-body{max-width:440px}.wallet-address{display:block;margin-top:18px}.wallet-panel{padding:28px}.wallet-total{font-size:48px}
      .token{padding:62px 0 45px}.token-intro{font-size:13px}.token-facts{gap:20px;margin-top:35px;margin-bottom:29px}.token-facts>div+div{padding-left:20px}.token-facts dd{font-size:29px}
      .contract{padding:20px;align-items:flex-start;flex-direction:column;gap:6px}.contract code{font-size:12px}.contract a{min-height:36px}
    }
    @media(min-width:801px){.mobile-telegram{display:none}}
    @media(max-width:520px){
      .hero{padding-top:33px;padding-bottom:39px}.hero-lockup{display:flex;justify-content:space-between;align-items:center;gap:4px}
      .hero-word{font-size:clamp(77px,23vw,113px);margin-left:-4px;letter-spacing:-.075em;flex-shrink:0}.hero-face{position:static;width:34%;height:auto;aspect-ratio:1;flex-shrink:0;margin-right:-7px}
      .hero-title{font-size:clamp(28px,7.8vw,39px);line-height:1.12;letter-spacing:-.048em;margin-top:24px}.hero-title span:last-child{max-width:340px}
      .hero-description{font-size:16px;line-height:1.55;margin-top:20px;max-width:345px}.actions{gap:17px;margin-top:25px;flex-wrap:nowrap}.button{font-size:13px;padding:13px 17px;min-height:46px}.text-link{font-size:13px}
      .provenance{grid-template-columns:1fr 1fr;gap:14px 13px;padding:20px 0}.source-link{font-size:11px;gap:8px}.source-mark{width:25px;height:25px}.provenance-intro strong{font-size:12px}.provenance .utility{font-size:9px}
      .holders{padding-top:48px;padding-bottom:22px}.holders-heading{display:block}.holders .section-title{font-size:64px}.holders-subtitle{font-size:14px;margin-top:14px}.holders-aside{padding-top:20px;display:flex;gap:12px;align-items:center;justify-content:space-between}.holders-aside p{font-size:11px;margin:0}.holders-aside .text-link{font-size:12px}
      .rooftop{width:calc(100% + var(--gutter)*2);max-width:none;margin-left:calc(-1*var(--gutter));margin-top:3px}
      .movement{padding:50px 0 47px}.section-title{font-size:57px}.section-kicker{font-size:10px;margin-bottom:17px}.section-deck{font-size:21px;line-height:1.35;margin-top:21px}.section-body{font-size:15px;line-height:1.6;margin-top:13px}
      .split,.wallet .split{gap:34px}.ranking-header h3{font-size:14px}.ranking-header .utility{font-size:9px}.ranking th{font-size:9px}.ranking td{padding:13px 0}.ranking .rank{width:29px;font-size:10px}.ranking .account a{font-size:13px}.ranking .metric{width:103px}.metric-value{font-size:16px}.ranking-note{font-size:11px}
      .wallet{padding:52px 0}.wallet-panel{padding:21px 18px}.wallet-panel-head h3{font-size:12px}.snapshot-tag{font-size:8px}.wallet-total{font-size:42px;margin-top:14px}.wallet-date{font-size:10px}.balance-list{gap:21px 15px}.balance-list dd{font-size:17px}.balance-list dt{font-size:9px}.wallet-foot{font-size:10px}.chart-caption{font-size:10px}.chart-label{font-size:17px}
      .token{padding:49px 0 39px}.token-heading{align-items:start;flex-direction:column;gap:18px}.token-facts{gap:16px;grid-template-columns:.8fr .8fr 1.25fr;margin-top:27px}.token-facts>div+div{padding-left:16px}.token-facts dt{font-size:10px;margin-bottom:10px}.token-facts dd{font-size:24px}.token-links{gap:12px 24px;margin-top:13px}.token-links .text-link{font-size:12px}.contract{padding:17px}.contract code{font-size:11px}.contract-label{font-size:10px}
      .site-footer{padding:25px 0}.footer-main{align-items:flex-start;flex-direction:column;gap:14px}.footer-note{display:block;margin-top:14px;font-size:10px}.footer-note span{display:block;margin-top:8px}.footer-main .brand-name{font-size:12px}.footer-link{font-size:12px}
    }
    @media(forced-colors:active){*{scrollbar-color:auto}.button{border:1px solid ButtonText}.hero-face{filter:none;forced-color-adjust:none}.metric-bar{background:CanvasText}}
    @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation:none!important;transition:none!important}a:hover,a:focus-visible{transform:none!important}}
  /* Two related identities, each paired with its own original mark. */
.site-header .brand-group { display:flex; align-items:center; gap:16px; flex-shrink:0; }
.site-header .brand { display:inline-flex; align-items:center; gap:9px; text-decoration:none; }
.site-header .brand-token { font:600 23px/1 "Helvetica Neue",Helvetica,Arial,sans-serif; letter-spacing:-.055em; }
.site-header .brand-token .drb-cutout { width:40px; height:40px; flex-shrink:0; }
.site-header .brand-taskforce { border-left:1px solid var(--line); padding-left:16px; font:500 13px/1.25 "Helvetica Neue",Helvetica,Arial,sans-serif; letter-spacing:0; }
.site-header .brand-taskforce img { width:38px; height:38px; border-radius:50%; object-fit:cover; }
.site-header .brand-taskforce span { display:block; max-width:70px; }
.site-header .brand-taskforce b { font-weight:500; }
.site-header .brand-taskforce span span { white-space:nowrap; }
@media(max-width:1100px) {
  .assembly .site-menu { display:none; position:absolute; top:100%; left:0; right:0; padding:20px 32px; background:var(--bg); border-bottom:1px solid var(--line); box-shadow:0 12px 18px #0002; flex-wrap:wrap; }
  .assembly .site-menu.is-open { display:flex; }
  .assembly .menu-toggle { display:block; }
}
@media(max-width:560px) {
  .site-header .brand-group { gap:10px; }
  .site-header .brand { gap:6px; }
  .site-header .brand-token { font-size:19px; }
  .site-header .brand-token .drb-cutout { width:32px; height:32px; }
  .site-header .brand-taskforce { padding-left:10px; font-size:11px; }
  .site-header .brand-taskforce img { width:30px; height:30px; }
  .assembly .header-actions > .button { display:none; }
}

/* Original cutout on an elevated plane; shadows follow its strokes. */
.hero { isolation:isolate; }
.hero-face { z-index:2; color:#1b1d1f; overflow:visible; mix-blend-mode:normal; filter:drop-shadow(0 2px 0 #92979b) drop-shadow(0 12px 9px #1b1d1f26) drop-shadow(0 30px 22px #1b1d1f12); }
@media(max-width:800px) { .hero-face { position:relative; top:auto; right:auto; filter:drop-shadow(0 1px 0 #92979b) drop-shadow(0 7px 5px #1b1d1f26); } }
@media(max-width:520px) { .site-header .brand-group { gap:10px; } .header-inner>.mobile-telegram { font-size:11px; } }

/* Separated header identities: community left, token right. */
.site-header .brand-taskforce{order:1;border:0;padding:0;gap:12px;font:500 16px/1.2 var(--sans);letter-spacing:0}
.site-header .brand-taskforce img{width:38px;height:38px;border-radius:50%}
.site-header .brand-taskforce span{max-width:none;white-space:nowrap}
.site-header .brand-token{order:3;gap:8px;font:500 20px/1 var(--sans);letter-spacing:-.04em}
.site-header .brand-token .drb-cutout{width:32px;height:32px}
.site-header .nav{order:2}
@media(max-width:800px){
 .site-header .brand-taskforce{grid-column:1;grid-row:1;font-size:14px;gap:10px}
 .site-header .brand-token{grid-column:2;grid-row:1;justify-self:end;font-size:18px}
 .site-header .nav .header-telegram{display:inline-flex!important}
}
@media(max-width:520px){
 .site-header .brand-taskforce{font-size:12px;gap:8px}
 .site-header .brand-taskforce img{width:30px;height:30px}
 .site-header .brand-token{font-size:18px;gap:6px}
 .site-header .brand-token .drb-cutout{width:28px;height:28px}
 .site-header .nav{font-size:12px;gap:4px}
}
@media(max-width:380px){.site-header .nav{font-size:11px}}

/* The smile balances the full introduction; it must not stretch the wordmark row. */
.hero { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,.88fr); column-gap:clamp(24px,5vw,72px); }
.hero-lockup { display:contents; }
.hero-word { grid-column:1; grid-row:1; width:auto; font-size:clamp(136px,14vw,180px); line-height:1; min-width:0; }
.hero-face { grid-column:2; grid-row:1/5; align-self:center; position:relative; top:auto; right:auto; width:380px; max-width:100%; height:auto; aspect-ratio:264/196; justify-self:center; overflow:visible; transform:none; }
.hero-title { grid-column:1; grid-row:2; margin-top:12px; }
.hero-description { grid-column:1; grid-row:3; }
.hero > .actions { grid-column:1; grid-row:4; }
.holders-aside { align-self:center; }
@media(max-width:1100px) { .hero-face { width:330px; } .hero-word { font-size:clamp(125px,14vw,156px); } }
@media(max-width:800px) { .hero { display:block; } .hero-lockup { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,.88fr); align-items:center; gap:24px; } .hero-face { grid-row:1; width:270px; transform:translateY(-2px); } .hero-word { font-size:clamp(92px,17vw,132px); } .hero-title { margin-top:18px; } }
@media(max-width:520px) { .hero-lockup { grid-template-columns:minmax(0,1fr) minmax(0,.82fr); gap:16px; } .hero-word { font-size:clamp(56px,18vw,92px); } .hero-face { width:100%; margin-right:0; transform:translateY(-2px); } .holders-aside { padding-top:32px; } }
</style>
</head>
