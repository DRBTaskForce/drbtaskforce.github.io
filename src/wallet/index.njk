---
layout: base.njk
secondary: true
title: "Grok's Wallet — $DRB Balances & Fees"
description: "Explore Grok's wallet on Base: balances, claimed fees, and saved balance history."
pageStyle: wallet
pageScript: wallet
---

{% set historicalSnapshot = wallet.walletValueAllTime | last %}
{% set snapshot = wallet.currentSnapshot or historicalSnapshot %}
<div class="wrap wallet-page">
  <header class="page-heading">
    <p class="eyebrow">Grok’s wallet · Base</p>
    <h1>Follow the wallet.</h1>
    <p class="intro">Balances, claimed fees, and recorded activity from Grok’s wallet on Base. The numbers, with a trail you can follow.</p>
    <a href="https://basescan.org/address/{{ wallet.walletAddress }}" target="_blank" rel="noopener noreferrer" class="text-link wallet-address">
      <span>{{ wallet.walletAddress }}</span><span aria-hidden="true"></span>
      <span class="visually-hidden">View wallet on Basescan</span>
    </a>
  </header>

  <section class="wallet-overview" aria-labelledby="wallet-overview-title">
    <div class="section-top wallet-overview-top">
      <h2 id="wallet-overview-title">At a glance.</h2>
      <div class="wallet-currency">
        <label for="currency-select">Display in</label>
        <select id="currency-select" aria-describedby="currency-status" disabled>
          <option value="USD">USD — US Dollar</option>
        </select>
      </div>
    </div>
    <p id="currency-status" class="wallet-currency-status" role="status">Values shown in USD. Currency conversion requires current exchange rates.</p>

    <div class="data-panel wallet-total">
      <div>
        <p class="eyebrow">Estimated wallet value</p>
        <p class="wallet-total-value" id="stat-total">{% if snapshot %}${{ snapshot.usd }}{% else %}Unavailable{% endif %}</p>
        <p class="wallet-note" id="stat-total-sub">DRB + WETH + ETH + USDC combined · USD</p>
      </div>
      <div class="wallet-snapshot">
        <p class="eyebrow">Saved snapshot</p>
        <p>{% if snapshot %}<time datetime="{{ snapshot.observedAt or snapshot.date }}">{% if wallet.currentSnapshot %}{{ homeWallet.asOf }}{% else %}{{ snapshot.date | formatDate }}{% endif %}</time>{% else %}Unavailable{% endif %}</p>
        <p id="stat-updated-sub" class="wallet-note" role="status">Showing saved balances.</p>
      </div>
    </div>

    <dl class="wallet-stats">
      <div class="wallet-stat">
        <dt>DRB balance</dt>
        <dd class="wallet-stat-value" id="stat-balance">{% if snapshot %}{{ snapshot.drb | formatDrb }} DRB{% else %}Unavailable{% endif %}</dd>
        <dd class="wallet-note" id="stat-balance-local">Saved balance</dd>
      </div>
      <div class="wallet-stat">
        <dt>WETH balance</dt>
        <dd class="wallet-stat-value" id="stat-weth">{% if snapshot %}{{ snapshot.weth | formatWeth }} WETH{% else %}Unavailable{% endif %}</dd>
        <dd class="wallet-note" id="stat-weth-usd">Saved balance</dd>
      </div>
      <div class="wallet-stat">
        <dt>ETH balance</dt>
        <dd class="wallet-stat-value" id="stat-eth">{% if snapshot %}{{ snapshot.eth | formatWeth }} ETH{% else %}Unavailable{% endif %}</dd>
        <dd class="wallet-note" id="stat-eth-usd">Saved balance</dd>
      </div>
      <div class="wallet-stat">
        <dt>USDC balance</dt>
        <dd class="wallet-stat-value" id="stat-usdc">{% if snapshot %}{{ snapshot.usdc }} USDC{% else %}Unavailable{% endif %}</dd>
        <dd class="wallet-note" id="stat-usdc-sub">Saved balance</dd>
      </div>
    </dl>

    <div class="wallet-details">
      <div>
        <p class="eyebrow">$DRB price</p>
        <p class="wallet-detail-value" id="stat-price">{% if snapshot %}${{ snapshot.drbPrice }}{% else %}Unavailable{% endif %}</p>
        <p class="wallet-note" id="stat-price-sub">USD · saved price</p>
      </div>
      <div>
        <p class="eyebrow">Cumulative WETH received</p>
        <p class="wallet-detail-value">{{ wallet.cumulativeWethEarned | formatWeth }} WETH</p>
        <p class="wallet-note">{{ wallet.totalWethTransactions }} incoming transfers in the saved record{% if homeWallet.receiptsAsOf %} · {{ homeWallet.receiptsAsOf }}{% endif %}</p>
      </div>
    </div>
  </section>

  <section class="section wallet-history" aria-labelledby="wallet-history-title">
    <div class="section-top">
      <div>
        <p class="eyebrow">The record</p>
        <h2 id="wallet-history-title">Balance history.</h2>
      </div>
      <div class="segmented" role="group" aria-label="Balance history period">
        <button id="btn-30d" type="button" aria-pressed="true" aria-controls="wallet-charts wallet-history-table">30 days</button>
        <button id="btn-90d" type="button" aria-pressed="false" aria-controls="wallet-charts wallet-history-table">90 days</button>
      </div>
    </div>
    {% if homeWallet.historyNotice %}<p class="wallet-note" role="status">{{ homeWallet.historyNotice }}</p>{% endif %}
    <p class="wallet-note wallet-history-range" id="history-range" role="status">Daily snapshots through {% if historicalSnapshot %}{{ historicalSnapshot.date | formatDate }}{% else %}the last saved record{% endif %}.</p>

    <div class="wallet-chart-grid" id="wallet-charts">
      {% for asset, label in { drb: 'DRB balance', weth: 'WETH balance', eth: 'ETH balance', usdc: 'USDC balance' } %}
      <article class="data-panel wallet-chart-panel">
        <h3>{{ label }}</h3>
        <p class="wallet-chart-summary wallet-note" id="summary-{{ asset }}">Saved daily balances</p>
        <div class="wallet-chart-area">
          <canvas id="chart-{{ asset }}" role="img" aria-label="{{ label }} history" aria-describedby="summary-{{ asset }}">Read the saved balance history in the table below.</canvas>
        </div>
      </article>
      {% endfor %}
    </div>

    <p class="wallet-note wallet-chart-status" id="chart-status" role="status">Charts require JavaScript. Saved values are available below.</p>
    <details class="wallet-history-details" id="history-details">
      <summary>Read the balance history</summary>
      <div class="wallet-history-scroll" role="region" tabindex="0" aria-label="Saved wallet balance history">
        <table id="wallet-history-table">
          <caption>Saved daily balances. Amounts are in each token’s own units.</caption>
          <thead><tr><th scope="col">Date (UTC)</th><th scope="col">DRB</th><th scope="col">WETH</th><th scope="col">ETH</th><th scope="col">USDC</th></tr></thead>
          <tbody id="history-rows">
            {% for point in homeWallet.history | reverse %}
            <tr><th scope="row"><time datetime="{{ point.date }}">{{ point.date | formatDate }}</time></th><td>{{ point.drb | formatDrb }}</td><td>{{ point.weth | formatWeth }}</td><td>{{ point.eth | formatWeth }}</td><td>{{ point.usdc }}</td></tr>
            {% else %}
            <tr><td colspan="5">No saved balance history is available.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </details>
    <div class="wallet-history-note">
      <p class="wallet-note">History reflects saved daily snapshots. Current balances and prices may differ.</p>
      <a href="https://basescan.org/address/{{ wallet.walletAddress }}" target="_blank" rel="noopener noreferrer" class="text-link">View on Basescan</a>
    </div>
    {% if wallet.accountingCoverage.missingL1FeeTransactions %}<p class="wallet-note">Historical ETH balances may omit some network fees that the data source did not provide. Current balances are checked separately.</p>{% endif %}
    <p class="wallet-note wallet-event-note">Record context: <a href="https://x.com/0xdeployer/status/2051315834212303334" target="_blank" rel="noopener noreferrer" class="text-link">May 4, 2026 prompt injection attack</a></p>
  </section>
</div>

<script id="wallet-data" type="application/json">{{ wallet | dump | safe }}</script>
<script id="wallet-chart-library" src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js" integrity="sha384-JUh163oCRItcbPme8pYnROHQMC6fNKTBWtRG3I3I0erJkzNgL7uxKlNwcrcFKeqF" crossorigin="anonymous" defer></script>
<script id="wallet-annotation-library" src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@3.1.0/dist/chartjs-plugin-annotation.min.js" integrity="sha384-3N9GHhCtN3CQef6tNfqgZlv7sQLYIkcChN+uaTZ7xVdzKYp/SjBNPxa92+hM7EAY" crossorigin="anonymous" defer></script>
